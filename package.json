{
  "name": "dfx-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @dfx-crm/web dev",
    "build": "pnpm typecheck && pnpm --filter @dfx-crm/web build",
    "preview": "pnpm --filter @dfx-crm/web preview",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "fields:export": "tsx scripts/export-field-registry.ts"
  },
  "devDependencies": {
    "@dfx-crm/core": "workspace:*",
    "@dfx-crm/mock-data": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
